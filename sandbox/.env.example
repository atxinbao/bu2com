# BU2 默认 Reference Server
BU2_SANDBOX_PORT=3100
BU2_ENVIRONMENT=local
BU2_PAYMENT_ADAPTER=simulated
BU2_EXECUTION_STATUS=execution_enabled
# local 默认使用 development_open；Sandbox/Live 必须使用 authenticated。
# BU2_ACCESS_MODE=development_open

# x402 Sandbox 是另一套部署配置；使用时替换上面的 local 值并取消注释。
# BU2_X402_SANDBOX_URL=http://127.0.0.1:3101
# BU2_SANDBOX_DB=./data/bu2-x402.sqlite
# BU2_ENVIRONMENT=sandbox
# BU2_PAYMENT_ADAPTER=x402
# BU2_CHAIN_ID=84532
# BU2_NETWORK=eip155:84532
# BU2_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# BU2_PROVIDER_NETWORK=eip155:84532
# BU2_PROVIDER_SCHEME=exact
# BU2_EXECUTION_STATUS=execution_enabled
# BU2_ACCESS_MODE=authenticated
# BU2_API_CREDENTIALS_JSON=[{"id":"key_...","token_sha256":"<sha256>","environment":"sandbox","tenant_id":"ten_...","principal_id":"agt_...","role":"agent","account_ids":["acct_..."],"agent_ids":["agt_..."],"generation":1,"status":"active"}]
# Agent/SDK/MCP 进程另行读取原始 BU2_API_KEY；不要把原始 key 写进本文件或仓库。
# BU2_SIGNER_ENVIRONMENT=sandbox
# X402_RESOURCE_URL=http://127.0.0.1:4021/premium-data
# 推荐使用 macOS 钥匙串中的 bu2-x402-base-sepolia/buyer-private-key。
# 仅在非 macOS 环境中才通过进程环境传入：
# X402_BUYER_PRIVATE_KEY=0x_REPLACE_WITH_FUNDED_BASE_SEPOLIA_TEST_KEY

# Hosted Sandbox 入口禁止上面的直接 Secret 变量，改用平台挂载的只读文件：
# BU2_API_CREDENTIALS_FILE=/run/secrets/bu2_api_credentials
# X402_BUYER_PRIVATE_KEY_FILE=/run/secrets/x402_buyer_private_key
# BU2_RPC_URL_FILE=/run/secrets/base_sepolia_rpc_url
# 托管目标还必须显式设置实际 x402 商户资源 URL；不得使用此占位域名启动：
# X402_RESOURCE_URL=https://merchant.sandbox.example.invalid/premium-data
