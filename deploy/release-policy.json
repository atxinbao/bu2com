{
  "schema_version": "ci03.release-policy.v2",
  "release_class": "social_wallet_local_integration_rc",
  "candidate_version_pattern": "^social-wallet-v[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.[1-9][0-9]*$",
  "source": {
    "event": "workflow_dispatch",
    "ref": "refs/heads/main",
    "workflow_commit_must_match_candidate": true,
    "existing_tag_forbidden": true
  },
  "artifact": {
    "format": "docker_archive",
    "immutable_reference_required": true,
    "retention_days": 90
  },
  "historical_baseline": {
    "tag": "ledger-rc-local-v0.1",
    "commit": "005b3949de4672a5aae301bd9b511e47b8be89fa",
    "immutable": true
  },
  "required_ci_checks": [
    "sandbox_full_regression",
    "la06a_targeted_boundary_tests",
    "deployment_and_hosted_contracts",
    "contract_validation",
    "typescript_sdk",
    "prototype_lint",
    "prototype_build"
  ],
  "boundary": {
    "environment": "local",
    "execution_backend": "simulated",
    "execution_status": "execution_disabled",
    "provider_call": false,
    "signer_loaded": false,
    "payment_execution_attempted": false,
    "live_enabled": false,
    "la06b": "not_executed"
  },
  "capabilities": [
    "local_ledger_integration",
    "sqlite_schema_22",
    "wallet_read_model_v1",
    "local_wallet_read_cutover",
    "account_scoped_wallet_writes",
    "buyer_side_provider_fee_spend_semantics",
    "social_wallet_local_acceptance",
    "wal_and_online_backup_restore",
    "immutable_docker_archive",
    "source_and_evidence_bound_manifest"
  ],
  "explicit_exclusions": [
    "public_wallet_api",
    "collection_runtime_wallet_credit",
    "hosted_deployment",
    "sandbox_testnet_bilateral_settlement",
    "live_mainnet_execution",
    "real_funds",
    "production_custody",
    "automatic_tag_or_release",
    "registry_publish"
  ],
  "approval": {
    "project_owner_release_approval_required": true,
    "separate_human_reviewer_required": false,
    "ai_self_approval_forbidden": true,
    "merge_is_not_release_authorization": true
  }
}
