{
  "schema_version": "1.0",
  "artifact_policy": {
    "mode": "single_immutable_image",
    "reference_variable": "BU2_ARTIFACT_IMAGE",
    "accepted_reference_forms": ["sha256:<image-id>", "<registry>/<image>@sha256:<digest>"]
  },
  "units": {
    "sandbox": {
      "service": "sandbox",
      "runtime_identity": "bu2sandbox",
      "runtime_uid": 10001,
      "payment_adapter": "x402",
      "chain_id": 84532,
      "network_id": "eip155:84532",
      "data_volume": "sandbox-data",
      "data_path": "/var/lib/bu2/sandbox",
      "network": "sandbox-network",
      "secret_namespace": "bu2/sandbox",
      "backup_scope": "bu2-sandbox",
      "provider_scope": "bu2-sandbox",
      "execution_status": "execution_disabled",
      "signer_mount": "forbidden"
    },
    "live": {
      "service": "live",
      "runtime_identity": "bu2live",
      "runtime_uid": 10002,
      "payment_adapter": "x402",
      "chain_id": 8453,
      "network_id": "eip155:8453",
      "data_volume": "live-data",
      "data_path": "/var/lib/bu2/live",
      "network": "live-network",
      "secret_namespace": "bu2/live",
      "backup_scope": "bu2-live",
      "provider_scope": "bu2-live",
      "execution_status": "execution_disabled",
      "signer_mount": "forbidden"
    }
  },
  "shared": ["artifact_digest", "compose_template", "environment_contract_version"],
  "must_not_share": [
    "runtime_identity",
    "data_volume",
    "data_path",
    "network",
    "secret_namespace",
    "backup_scope",
    "provider_scope"
  ],
  "prohibited_environment_variables": [
    "X402_BUYER_PRIVATE_KEY",
    "BU2_SIGNER_ENVIRONMENT",
    "BU2_CLAIM_LEGACY_DB_ENVIRONMENT"
  ]
}
